public component Chrome() {
  Row(
    class: "gap-0",
    children: [
      TabBar(
        side: "left",
        children: [
          Tab("Name", id: "sort-name", selected: true),
          Tab("Size", id: "sort-size")
        ]
      ),
      Panel(
        class: "p-8 gap-4 bg-panel border-vanilla",
        children: [
          SearchBar(id: "search", placeholder: "Search..."),
          Separator(class: "w-88"),
          Row(
            class: "gap-4 items-center",
            children: [
              Checkbox(id: "craftable", value: false),
              Toggle(id: "nei", value: true),
              Slider(
                id: "zoom",
                value: 2,
                max: 8,
                class: "w-64"
              )
            ]
          )
        ]
      ),
      Scrollbar(
        id: "scroll",
        value: 0,
        max: 10,
        class: "h-54"
      )
    ]
  )
}
